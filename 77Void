local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if isAdmin and Settings.Silent and method == "FireServer" and self:IsA("RemoteEvent") then
        local target = GetSilentTarget()
        if target and target.Character then
            local part = target.Character:FindFirstChild(Settings.SilentHitPart)
            if part then
                if math.random(1, 100) > Settings.SilentChance then return oldNamecall(self, ...) end
                local aimPos = part.Position
                local args = {...}
                local changed = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = aimPos; changed = true
                    elseif typeof(v) == "CFrame" then
                        args[i] = CFrame.lookAt(v.Position, aimPos); changed = true
                    end
                end
                if changed then return oldNamecall(self, table.unpack(args)) end
            end
        end
    end
    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

