local function IsAlly(p)
    if not p or p == LocalPlayer then return false end
    if not LocalPlayer.Team then return false end
    if p.Team and p.Team == LocalPlayer.Team then return true end
    if p.TeamColor and LocalPlayer.TeamColor and p.TeamColor == LocalPlayer.TeamColor then return true end
    return false
end

local function ehChat(n)
    n = n:lower()
    return n:find("chat") or n:find("bubble") or n:find("textchat") or n:find("topbar")
end

local function definirVisibilidadeExecutor(vis)
    local eg = gethui and gethui() or Services.CoreGui
    if not eg then return end
    if vis then
        for _, gui in pairs(guisEscondidos) do
            pcall(function() gui.Enabled = true end)
        end
        guisEscondidos = {}
    else
        guisEscondidos = {}
        for _, item in pairs(eg:GetChildren()) do
            if item:IsA("ScreenGui") and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
        for _, item in pairs(Services.CoreGui:GetChildren()) do
            if item:IsA("ScreenGui")
                and item.Name ~= "LpModsFloatingButtonGui"
                and item.Name ~= "LpModsDiscordBtn"
                and item.Name ~= "LpAdminPainel"
                and not item.Name:find("Fluent")
                and not ehChat(item.Name) then
                if item.Enabled then item.Enabled = false; table.insert(guisEscondidos, item) end
            end
        end
    end
end

