local function getRoot(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChild("HumanoidRootPart")
        or p.Character:FindFirstChild("Torso")
        or p.Character:FindFirstChild("UpperTorso")
end

local function getHum(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChildOfClass("Humanoid")
end

local function getHitPart(p)
    if not p or not p.Character then return nil end
    return p.Character:FindFirstChild(Settings.ParteDoHit)
        or p.Character:FindFirstChild("Head")
        or p.Character:FindFirstChild("HumanoidRootPart")
end

local function isBlacklisted(name)
    if Settings.NaoMatar == "Ninguem" then return false end
    return name == Settings.NaoMatar
end

local function getAlvos()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = getHum(p)
            local root = getRoot(p)
            if hum and root and hum.Health > 0 and not isBlacklisted(p.Name) then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function getArmaLocal()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then return t end
    end
    return nil
end

local function atacar(p)
    if not p or not p.Character then return end
    local myRoot = getRoot(LocalPlayer)
    local targetRoot = getRoot(p)
    if not myRoot or not targetRoot then return end

    local hitPart = getHitPart(p)
    if not hitPart then return end

    local tool = getArmaLocal()
    if tool then
        pcall(function()
            if tool.Activate then tool:Activate() end
        end)
    end

    pcall(function()
        if type(mouse1click) == "function" then
            mouse1click()
        elseif type(mouse1press) == "function" and type(mouse1release) == "function" then
            mouse1press(); task.wait(0.02); mouse1release()
        elseif type(keypress) == "function" and type(keyrelease) == "function" then
            keypress(0x01); task.wait(0.02); keyrelease(0x01)
        end
    end)

    pcall(function()
        if tool and tool:FindFirstChild("Handle") then
            tool.Handle:Touch(targetRoot)
        end
    end)

    local oldCF = myRoot.CFrame
    local backDir = (myRoot.Position - targetRoot.Position)
    if backDir.Magnitude < 0.1 then backDir = Vector3.new(0, 0, 1) end
    backDir = backDir.Unit
    myRoot.CFrame = CFrame.new(targetRoot.Position + backDir * 2)
    task.wait(0.02)
    pcall(function()
        if tool then
            if tool.Activate then tool:Activate() end
        end
    end)
    task.wait(0.02)
    if myRoot and myRoot.Parent then
        myRoot.CFrame = oldCF
    end
end

local function getMaisProximo()
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return nil end
    local closest, dist = nil, math.huge
    for _, p in ipairs(getAlvos()) do
        local root = getRoot(p)
        if root then
            local d = (root.Position - myRoot.Position).Magnitude
            if d < dist then dist = d; closest = p end
        end
    end
    return closest
end

local function getMenorHP()
    local closest, hp = nil, math.huge
    for _, p in ipairs(getAlvos()) do
        local hum = getHum(p)
        if hum and hum.Health < hp then hp = hum.Health; closest = p end
    end
    return closest
end

local lastAura = 0
local lastKillAll = 0

RunService.Heartbeat:Connect(function()
    if not Settings.Killaura then return end
    if tick() - lastAura < Settings.DelayAura then return end
    lastAura = tick()

    local target
    if Settings.FocarMenorHP then
        target = getMenorHP()
    else
        target = getMaisProximo()
    end
    if target then atacar(target) end
end)

RunService.Heartbeat:Connect(function()
    if not Settings.MatarTodos then return end
    if tick() - lastKillAll < Settings.DelayKillAll then return end
    lastKillAll = tick()

    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return end

    for _, p in ipairs(getAlvos()) do
        local root = getRoot(p)
        if root then
            local oldCF = myRoot.CFrame
            myRoot.CFrame = CFrame.new(root.Position + Vector3.new(0, 0, 2))
            task.wait(0.01)
            atacar(p)
            task.wait(0.01)
            if myRoot and myRoot.Parent then myRoot.CFrame = oldCF end
        end
    end
end)

